# Copy this file to android/keystore.properties on the machine that builds a
# release. Both files stay out of git. Do not put a real password in the example.
#
# The owner creates the keystore outside the repository and keeps two backups.
# Environment variables override this file:
#   CATDIAO_KEYSTORE, CATDIAO_KEYSTORE_PASSWORD, CATDIAO_KEY_ALIAS, CATDIAO_KEY_PASSWORD
storeFile=
storePassword=
keyAlias=catdiao
keyPassword=
